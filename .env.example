# ── Supabase (optional — the app runs in DEMO MODE without these) ─────────
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Copy these values from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Admin demo login (used when Supabase auth is NOT configured)
NEXT_PUBLIC_DEMO_ADMIN_USERNAME=Adam
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=Password123

# UTM / analytics
NEXT_PUBLIC_SITE_URL=http://localhost:3000
